<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>8</LangVersion>
		<IsPackable>true</IsPackable>
		<PackageId>Byndyusoft.ApiClient</PackageId>
		<RootNamespace>Byndyusoft.ApiClient</RootNamespace>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Byndyusoft.Net.Http" Version="0.4.4" />
		<PackageReference Include="Byndyusoft.Net.Http.Json" Version="0.3.2" />
		<PackageReference Include="Byndyusoft.Net.Http.MessagePack" Version="0.6.0" />
		<PackageReference Include="Byndyusoft.Net.Http.ProtoBuf" Version="0.5.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
